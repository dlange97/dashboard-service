APP_ENV=dev
APP_SECRET=change_me_dashboard_secret
DATABASE_URL="mysql://app:change_me_db_password@mysql:3306/dashboard?serverVersion=8.4&charset=utf8mb4"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|[a-z0-9-]+\.mydashboard\.(local|com))(:[0-9]+)?$'
LOCK_DSN=flock
VAR_DUMPER_SERVER=127.0.0.1:9912

AUTH_SERVICE_URL=http://auth-php:9000
NOTIFICATION_SERVICE_URL=http://nginx
INTERNAL_NOTIFICATION_TOKEN=change_me_internal_notification_token

# Wish Search / AI
AI_PROVIDER=mock
AI_MODEL=
AI_SEARCH_DEFAULT_LIMIT=5
AI_SEARCH_MAX_LIMIT=100

# Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# AWS Bedrock provider
AWS_BEDROCK_REGION=eu-central-1
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_SESSION_TOKEN=
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
